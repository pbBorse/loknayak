# Copy this file to ".env" and edit. Everything is OPTIONAL - the site works without it.
PORT=3000
SITE_URL=http://localhost:3000
# AI Enhance (Anthropic Claude). Get a key at console.anthropic.com
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
